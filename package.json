{
  "name": "manyaki-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Manyaki - a desktop VRM study companion",
  "author": "Naman",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis",
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs"
  },
  "devDependencies": {
    "@google/genai": "^2.30.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "get-windows": "^9.3.0",
    "node-llama-cpp": "^3.22.1",
    "kokoro-js": "^1.2.1",
    "@huggingface/transformers": "3.8.1"
  },
  "build": {
    "appId": "com.naman.manyaki",
    "productName": "Manyaki",
    "copyright": "Naman",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/@node-llama-cpp/*cuda*/**",
      "!node_modules/@node-llama-cpp/*arm64*/**",
      "!node_modules/@node-llama-cpp/*linux*/**",
      "!node_modules/@node-llama-cpp/*mac*/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/node-llama-cpp/llama/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/get-windows/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Manyaki"
    },
    "npmRebuild": false
  }
}
